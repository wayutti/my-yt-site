---
const { frontmatter } = Astro.props;
---

<!doctype html>
<html lang="ja">
<head>
    <meta charset="utf-8">
    <title>{frontmatter?.title || '小傘推しによるホームページ'}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
<div class="header">
        <div>
            <p>
                <a href="/" class="header-tt">小傘推しによるホームページ</a>
            </p>
        </div>
    </div>
    <div class="oya">
        <div class="content">
                <h1>{frontmatter?.title && <h1>{frontmatter.title}</h1>}</h1>
                {/* 本文 */}
                <slot />
        </div>
        <div class="side-bar">
            <div class="site-menu">
                <h2 class="menu-t">サイトメニュー</h2>
                <ul class="menu-list">
                    <li><a href="/">トップページ</a></li>
                </ul>
            </div>
        </div>
    </div>
    <div class="footer">
        <p>Copyright (C) 2026 kogasa-h9m All rights reserved.</p>
    </div>
</body>
</html>


<style>
    .header {
        padding: 0% 28px;
    }

    .header-tt {
        font-size: 24px;
        text-decoration: none !important;
        color: #000 !important;
    }

    .header-tt a:hover {
        text-decoration: none !important;
    }


    body {
        margin: 0%;
        padding: 0;
        background-color: #f6f6f6;
    }

    .oya {
        display: flex;
        align-items: flex-start;
        gap: 20px;
        max-width: 1200px;
        margin: 30px auto;
        padding: 0 20px;
    }

    .content {
        width: 80%;
        margin: 16px;
        flex: 1;
        background-color: #ffffff;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    }

    .content > *:first-child {
        margin-top: 0;
    }

    .side-bar {
        width: 20%;
        box-sizing: border-box;
    }

    .menu-t {
        font-size: 1.1rem;
        border-bottom: 2px solid #333;
        padding-bottom: 8px;
        margin-top: 0;
    }

    .menu-list {
        list-style: disc;
        padding-left: 20px;
    }

    .menu-list li {
        margin-bottom: 8px;
    }

    .menu-list a {
        color: #333;
        text-decoration: none;
    }

    .menu-list a:hover {
        text-decoration: underline;
    }

    .footer {
        color: #ffffff;
        text-align: center;
        background-color: #666;
        padding: 6px 8px;
    }

    a {
        color: #000;
        text-decoration: none;
    }

    a:hover {
        text-decoration: underline;
    }

    .post-link a {
        color: #000;
        text-decoration: none;
    }

    .post-link a:hover {
        text-decoration: underline;
    }
</style>
</head>
<body>
    <div class="header">
        <div>
            <p>
                <a href="/" class="header-tt">小傘推しによるホームページ</a>
            </p>
        </div>
        <button id="hamburger-btn" class="hamburger-btn" aria-label="メニューを開く">
    <span class="bar"></span>
    <span class="bar"></span>
    <span class="bar"></span>
  </button>
    </div>
    <div class="oya">
        <div class="content">
            <div class="intro">
                <h2 class="section-tt">自己紹介的な</h2>
                    <p>
                        気まぐれで更新している、kogasa-h9mのサイトです。<br>
                        雑記やらなんやらおいてます<br>
                        レイアウト気持ち悪いです。気にしたら負けよ
                    </p>
            </div>
            <div class="article">
                <h2 class="section-tt">Articles</h2>
                {allTags.length > 0 && (
        <div class="tag-container">
            <button class="tag-btn active" data-tag="all">すべて</button>
            {allTags.map((tag) => (
                <button class="tag-btn" data-tag={tag}>#{tag}</button>
            ))}
        </div>
    )}
                    <div class="post-grid">
    {posts.map((post: any) => {
        const rawTags = post.frontmatter?.tags;
        const tagList = Array.isArray(rawTags) 
            ? rawTags 
            : typeof rawTags === 'string' ? [rawTags] : [];
        const tagString = tagList.join(',');

        return (
            <a 
                href={post.url} 
                class="post-card" 
                data-tags={tagString}
            >
                <h3 class="post-title">{post.frontmatter?.title || '記事タイトル'}</h3>
                <p class="post-description">{post.frontmatter?.description || '記事のプレビュー'}</p>
                <span class="post-date">{post.frontmatter?.date || '20xx-xx-xx'}</span>
                
                {tagList.length > 0 && (
                    <div class="card-tags">
                        {tagList.map((t: string) => (
                            <span class="card-tag">#{t}</span>
                        ))}
                    </div>
                )}
            </a>
        );
    })}
</div>
            </div>
        </div>
        <div class="side-bar">

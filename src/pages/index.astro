---
import fs from 'node:fs';
import path from 'node:path';

const rawPosts = Object.values(import.meta.glob('../pages/posts/*.mdx', { eager: true }));

const posts = rawPosts.map((post: any) => {
  let previewText = post.frontmatter?.description;

  if (!previewText && post.file) {
    try {
      const fileContent = fs.readFileSync(post.file, 'utf-8');
      const bodyOnly = fileContent.replace(/^---[\s\S]*?---/, '').trim();
      const firstLine = bodyOnly
        .split('\n')
        .map((line: string) => line.trim())
        .find(
          (line: string) =>
            line.length > 0 &&
            !line.startsWith('#') &&
            !line.startsWith('import') &&
            !line.startsWith('export') &&
            !line.startsWith('<')
        );

      if (firstLine) {
        previewText = firstLine;
      }
    } catch (e) {
      console.error('ファイル読み込みエラー:', e);
    }
  }

  return {
    ...post,
    frontmatter: {
      ...post.frontmatter,
      description: previewText || '本文なし',
      tags: post.frontmatter?.tags || [], // タグがない場合は空配列
    },
  };
}).sort((a: any, b: any) => {
  const dateA = new Date(a.frontmatter?.date || '1970-01-01').getTime();
  const dateB = new Date(b.frontmatter?.date || '1970-01-01').getTime();
  if (dateA !== dateB) {
    return dateB - dateA;
  }
  const titleA = a.frontmatter?.title || '';
  const titleB = b.frontmatter?.title || '';
  return titleA.localeCompare(titleB, 'ja');
});

// 記事についているすべてのタグを重複なしで取得
const allTags = [...new Set(posts.flatMap((post: any) => post.frontmatter.tags))];
---

<!-- HTMLエリアは基本更新しない。 -->
<!doctype html>
<html lang="ja">
<head>
    <meta charset="utf-8">
